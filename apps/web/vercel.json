{
  "crons": [
    {
      "path": "/api/cron/calendar-subscriptions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/calendar-subscriptions-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/calendar-subscriptions-reconcile",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/calendar-subscriptions-reconcile?mode=stale",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/queuedFormResponseCleanup",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/tasks/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/tasks/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/credentials",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/selected-calendars",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {}
}
