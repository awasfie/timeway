# WC-TW-5a / CC-65: the one tzdata pin for Node/ICU, the image OS and Postgres. Bump all three in one PR:
# TZ_VERSION, ICU_DATA_COMMIT (unicode-org/icu-data commit carrying tzdata/icunew/<TZ_VERSION>), SHA256SUMS, and the
# Postgres digest in .github/workflows/tzdata-pin.yml (the shared prod DB must ship the same tzdata).
# 2026b = what the live shared Postgres (pgvector:pg16 @ sha256:ccc6e83d...) ships today.
TZ_VERSION=2026b
ICU_DATA_COMMIT=d7d6dd5bb68930c5e6b3dd4491574153d3a1ba5a
